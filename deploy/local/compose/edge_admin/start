#!/bin/bash
# deploy/local/compose/edge_admin/start

set -o errexit
set -o pipefail
set -o nounset

cleanup() {
    echo "Received shutdown signal, cleaning up..."

    # Signal only the Edge VPN CLI (netclient) daemon WE started. Do NOT use pgrep/pkill
    # by name — if this container ever runs with `pid: host` (the agent
    # does), a name match would find every netclient daemon on the host
    # and tear them down with us.
    if [ -n "${NETCLIENT_PID:-}" ] && kill -0 "$NETCLIENT_PID" 2>/dev/null; then
        echo "Stopping Edge VPN CLI (netclient) daemon (PID: $NETCLIENT_PID)..."
        kill -TERM "$NETCLIENT_PID" 2>/dev/null || true

        for _ in {1..5}; do
            if ! kill -0 "$NETCLIENT_PID" 2>/dev/null; then
                echo "Edge VPN CLI (netclient) daemon stopped gracefully"
                break
            fi
            sleep 1
        done

        if kill -0 "$NETCLIENT_PID" 2>/dev/null; then
            echo "Force killing Edge VPN CLI (netclient) daemon (PID: $NETCLIENT_PID)"
            kill -9 "$NETCLIENT_PID" 2>/dev/null || true
        fi
    else
        echo "No Edge VPN CLI (netclient) daemon to stop"
    fi

    # Netmaker creates these routing policy rules with priorities 3000, 2500, 2000.
    echo "Cleaning up routing policy rules..."
    ip rule delete pref 3000 2>/dev/null || true
    ip rule delete pref 2500 2>/dev/null || true
    ip rule delete pref 2000 2>/dev/null || true

    if ip link show netmaker &>/dev/null; then
        echo "Removing netmaker WireGuard interface..."
        ip link delete netmaker 2>/dev/null || true
    fi

    echo "Cleanup complete"
}

# Load-bearing lifecycle invariant: Admins are intentionally ephemeral. Every
# boot gets a fresh Admin VPN identity, and stale Admin hosts are cleaned later
# by zombie cleanup. Do not remove this wipe unless Admin persistent identity
# and stale-membership reconciliation are implemented as a full lifecycle.
echo "Resetting Admin VPN identity for ephemeral Admin lifecycle..."
rm -rf /etc/netclient/*

echo "Cleaning up stale WireGuard interface..."
ip link delete netmaker 2>/dev/null || true

# Use UPYUN ("Yun") mirror for hex.pm — if the Fastly-backed default is flaky
# https://hex.pm/docs/mirrors
# export HEX_MIRROR="https://hexpm.upyun.com"

mix deps.get
mix compile
mix run --no-start -e "EdgeAdmin.Release.migrate()"

# Rotate the encryption key when ROTATE_OLD_ENCRYPTION_* + ROTATE_NEW_ENCRYPTION_* envs
# are set. Idempotent — logs skip when envs are absent.
echo "Checking encryption key rotation..."
mix run --no-start -e "EdgeAdmin.Release.rotate_encryption_key()"

echo "Bootstrapping Edge VPN admin..."
mix run --no-start -e "EdgeAdmin.Release.bootstrap_edge_vpn_admin()"

echo "Bootstrapping default cluster..."
mix run --no-start -e "EdgeAdmin.Release.create_default_cluster()"

if [ -z "${ADMIN_CLUSTER_COOKIE:-}" ]; then
    echo "WARNING: ADMIN_CLUSTER_COOKIE is not set; using the built-in default Erlang cookie. Admin clustering still runs over VPN, but set ADMIN_CLUSTER_COOKIE to make the deployment explicit."
fi

if [ -z "${ADMIN_TCP_TUNNEL_SECRET:-}" ]; then
    echo "WARNING: ADMIN_TCP_TUNNEL_SECRET is not set; using the built-in default Admin TCP tunnel secret. Set it to make the deployment explicit."
fi

# Resolve WireGuard port for StatefulSet deployments.
# If POD_INDEX is set (injected by K8s Downward API), auto-compute the port
# from ADMIN_WIREGUARD_PORT_BASE + POD_INDEX — unless ADMIN_WIREGUARD_PORT is
# already explicitly set, which always takes precedence.
if [ -n "${POD_INDEX:-}" ] && [ -z "${ADMIN_WIREGUARD_PORT:-}" ]; then
    _base="${ADMIN_WIREGUARD_PORT_BASE:-51820}"
    export ADMIN_WIREGUARD_PORT=$(( _base + POD_INDEX ))
    echo "StatefulSet mode: POD_INDEX=${POD_INDEX}, ADMIN_WIREGUARD_PORT=${ADMIN_WIREGUARD_PORT} (base=${_base})"
    unset _base
fi

# Bootstrap is done — from here on we have side effects (netclient, epmd,
# wireguard interface) worth cleaning up on shutdown. Install the trap now so
# bootstrap failures don't trigger misleading "cleaning up" log noise.
trap cleanup EXIT INT TERM

echo "Starting EPMD daemon..."
export ERL_EPMD_PORT="${ADMIN_EPMD_PORT:-44369}"
epmd -daemon

# Tell netclient where to fetch canonical Core DERP map sources.
# CORE_DERP_MAP_URLS is Edge Admin configuration; DERP_MAP_URLS is netclient's contract.
# Must be set before netclient daemon starts; cannot be pushed into a running process.
if [ -n "${EDGE_VPN_API_SCHEME:-}" ]; then
    export NETMAKER_API_SCHEME="${EDGE_VPN_API_SCHEME}"
fi
if [ -n "${CORE_DERP_MAP_URLS:-}" ]; then
    export DERP_MAP_URLS="${CORE_DERP_MAP_URLS}"
fi

echo "Starting Edge VPN CLI (netclient) daemon..."
netclient daemon &
NETCLIENT_PID=$!
echo "Edge VPN CLI (netclient) daemon started with PID: $NETCLIENT_PID"

echo "Starting Phoenix server..."
export PHX_SERVER=true
mix phx.server &
PHOENIX_PID=$!

# Wait for either child to exit. If the Edge VPN CLI (netclient) dies, the server is unreachable
# from the mesh — bail out and let the orchestrator restart us. Disable
# errexit around `wait -n` so we can capture the exit code and propagate it.
set +e
wait -n $NETCLIENT_PID $PHOENIX_PID
EXIT_CODE=$?
set -e

if [ "$EXIT_CODE" -ne 0 ]; then
    echo "Child process exited with code $EXIT_CODE (edge_vpn_cli=$NETCLIENT_PID, phoenix=$PHOENIX_PID)" >&2
fi

exit $EXIT_CODE
