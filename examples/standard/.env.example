# examples/standard/.env.example
#
# Copy this file to .env and fill in your values before running.
# Lines marked REQUIRED must be set. Others have sensible defaults.
#
#   cp .env.example .env

# ==============================================================================
# DATABASE — Edge Admin (shared by all 4 admin instances)
# ==============================================================================

DB_HOST=edge_admin_db
DB_PORT=5432
# REQUIRED
DB_NAME=edge_admin
# REQUIRED
DB_USER=edge_admin_user
# REQUIRED — set a strong password
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_SSL=false

# ==============================================================================
# EDGE ADMIN — web server & API (shared by all instances)
# ==============================================================================

ADMIN_API_PORT=44000
# Optional dedicated MCP listener. When unset, MCP remains on the API listener
# at ADMIN_API_PORT (default: 44000).
# ADMIN_MCP_PORT=44001
# REQUIRED — generate with: openssl rand -base64 48
SECRET_KEY_BASE=change-me-generate-with-openssl-rand-base64-48

# REQUIRED — omnipotent key (internal ops, fallback for all other keys)
MASTER_KEY=change-me

# Optional scoped keys (default to MASTER_KEY if unset)
# API_KEY=        # REST API endpoints — give to external API clients
# METRICS_KEY=    # metrics endpoints only — give to Prometheus scrapers
# PROXY_KEY=      # proxy tunnel endpoints — give to proxy clients
# MCP_KEY=        # MCP server endpoint — give to AI assistants

# REQUIRED — encryption at rest for sensitive Ecto columns.
# ENCRYPTION_KEY: 32 bytes of base64 (generate with: openssl rand -base64 32)
# ENCRYPTION_TAG: identifier paired with ENCRYPTION_KEY; bump on each rotation.
# If ENCRYPTION_KEY is lost, every encrypted row is unrecoverable — back it up
# alongside MASTER_KEY / SECRET_KEY_BASE.
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
ENCRYPTION_TAG=AES.GCM.V1

# Encryption rotation envs. Set ALL FOUR to rotate on the next admin start (or
# via the one-off `rotate_encryption_key` release script). Leave commented otherwise.
# Idempotent — safe to re-run with the same values.
# ROTATE_OLD_ENCRYPTION_KEY=
# ROTATE_OLD_ENCRYPTION_TAG=
# ROTATE_NEW_ENCRYPTION_KEY=
# ROTATE_NEW_ENCRYPTION_TAG=

# Proxy ports
ADMIN_HTTP_PROXY_PORT=43128
ADMIN_SOCKS5_PROXY_PORT=41080

# Admin-to-Admin raw TCP tunnel secret. Optional; when unset the admin uses a
# built-in default and logs a warning. Use the same value on every Admin
# instance in the same Admin cluster. ADMIN_TCP_TUNNEL_PORT defaults to 45207.
ADMIN_TCP_TUNNEL_SECRET=change-me-strong-admin-tunnel-secret

# REQUIRED — full URL(s) agents use to reach admin instances, comma-separated.
# Can be private IPs, hostnames, or public domains — whatever is routable
# from your agent machines. Baked into enrollment keys.
# Direct-port setup:
ADMIN_URLS=http://your-server-ip-or-domain.com:34000,http://your-server-ip-or-domain.com:34001,http://your-server-ip-or-domain.com:34002,http://your-server-ip-or-domain.com:34003
# If you front the admins with Caddy, use the load-balanced hostname instead:
# ADMIN_URLS=http://edge-admin.yourdomain.com

# Optional — self-hosted relay map server URL for DERP overlay.
# Leave unset to fall back to Tailscale's public relay network.
# See examples/relay/ to deploy your own relay infrastructure.
# DERP_MAP_URL=https://edge-relay-map-1.yourdomain.com/derpmap/default

# --- Cluster A VPN subnet (shared by a1 + a2) ---
# REQUIRED — must not overlap with cluster B or edge cluster ranges. The IPv6
# sample uses a separate /48 from the default edge-cluster allocation pool.
ADMIN_A_CLUSTER_V4_SUBNET=100.63.0.0/24
ADMIN_A_CLUSTER_V6_SUBNET=fd7a:91c2:4e8c:1::/64

# --- Cluster B VPN subnet (shared by b1 + b2) ---
# REQUIRED — must not overlap with cluster A or edge cluster ranges. The IPv6
# sample uses a separate /48 from the default edge-cluster allocation pool.
ADMIN_B_CLUSTER_V4_SUBNET=100.63.1.0/24
ADMIN_B_CLUSTER_V6_SUBNET=fd7a:91c2:4e8c:2::/64

# WireGuard peer budget for each admin instance. Counts both admin-mesh peers
# (the other admin in the same admin cluster — pair size 2 here) and edge-node peers.
# Each admin derives edge_node_capacity = max_wireguard_peers - admin_peer_count;
# with two admins per cluster that's 250 - 1 = 249 edge nodes per admin.
ADMIN_MAX_WIREGUARD_PEERS=250

# Allow agents to enroll without a pre-signed token
PUBLIC_ENROLLMENT_KEY_ENABLED=true

# Default cluster pre-created on boot.
# `default` is reserved (used as a URL keyword on convenience routes) — pick any
# other valid name. Routes like POST /api/v1/clusters/default/enrollment_keys
# resolve to whichever cluster this variable names.
DEFAULT_CLUSTER_NAME=test
# Optional fixed dual-stack ranges for the default cluster. Leave both unset
# to allocate each family from its configured pool.
# DEFAULT_CLUSTER_V4_SUBNET=100.64.0.0/24
# DEFAULT_CLUSTER_V6_SUBNET=fd7a:91c2:4e8b::/64

# WireGuard userspace mode (required when running admin in a container)
WG_QUICK_USERSPACE_IMPLEMENTATION=wireguard-go

# Erlang cookie for the Admin cluster. Optional; when unset the admin uses a built-in
# default and logs a warning. If set, it must be identical across all admin
# instances in the same admin cluster.
ADMIN_CLUSTER_COOKIE=change-me-strong-random-cookie
ADMIN_CLUSTER_PORT=49125
ADMIN_DISCOVERY_PORT=44000

# Observability
METRICS_BASE_URL=edge_admin_a1:44000
SENTRY_ENVIRONMENT_NAME=production
# SENTRY_DSN=https://...@sentry.io/...

# ==============================================================================
# EDGE VPN
# ==============================================================================

# REQUIRED — address netclient uses to reach the Netmaker API.
# SERVER_API_CONN_STRING: baked into enrollment tokens; netclient dials scheme://SERVER_API_CONN_STRING/api/...
#   Plain IP works fine with http. If using TLS (https), must be a hostname that matches the cert.
# SERVER_HTTP_HOST: used by Netmaker for enrollment token JWTs and the UI backend URL.
# SERVER_HOST: fallback for SERVER_HTTP_HOST if not set; Netmaker also auto-detects public IP if both are unset.
SERVER_HOST=your-server-ip-or-domain.com
SERVER_HTTP_HOST=your-server-ip-or-domain.com
SERVER_API_CONN_STRING=your-server-ip-or-domain.com
EDGE_VPN_DEFAULT_DOMAIN=edge.internal

# REQUIRED — Edge VPN API URL and key
EDGE_VPN_API_URL=http://your-server-ip-or-domain.com:48081
EDGE_VPN_MASTER_KEY=change-me

# --- Netclient API Scheme ---
# Netclient defaults to HTTPS when talking to the Netmaker API.
# Set to "http" if your deployment has no TLS (plain IP, no domain/cert).
# Must be set on BOTH cloud.yml and edge.yml sides if using http.
# Omit entirely if you have a domain and Caddy is handling TLS.
# NETMAKER_API_SCHEME=http

# Edge VPN UI admin account (bootstrapped on first run)
EDGE_VPN_BOOTSTRAP_USERNAME=admin
# REQUIRED — set a strong password
EDGE_VPN_BOOTSTRAP_PASSWORD=change-me

SERVER_NAME=edge-vpn
CORS_ALLOWED_ORIGIN=*
API_PORT=8081
TELEMETRY=off
DEFAULT_DOMAIN=edge.internal
VERBOSITY=1

# REQUIRED — replace with your public hostname
# Uses EMQX WebSocket endpoint (wss:// for TLS, ws:// for plain)
SERVER_BROKER_ENDPOINT=ws://your-server-ip-or-domain.com:48083/mqtt
BROKER_ENDPOINT=ws://your-server-ip-or-domain.com:48083/mqtt
BROKER_TYPE=emqx

# REQUIRED — EMQX REST endpoint (internal container address)
EMQX_REST_ENDPOINT=http://edge_vpn_broker:18083
# REQUIRED — must match EMQX credentials below
MQ_USERNAME=admin
MQ_PASSWORD=change-me

STUN_SERVERS=stun1.l.google.com:19302,stun2.l.google.com:19302,stun.stunprotocol.org:3478,stun.nextcloud.com:443,stun.netmaker.io:3478

# ==============================================================================
# EDGE VPN DATABASE (PostgreSQL)
# ==============================================================================

# REQUIRED
VPN_DB_NAME=edge_vpn
# REQUIRED
VPN_DB_USER=edge_vpn
# REQUIRED — set a strong password
VPN_DB_PASSWORD=change-me

# Also used directly by Edge VPN server
SQL_HOST=edge_vpn_db
SQL_PORT=5432
SQL_USER=edge_vpn
SQL_PASS=change-me
SQL_DB=edge_vpn
SQL_SSL_MODE=disable
DATABASE=postgres

# ==============================================================================
# EMQX MQTT BROKER
# ==============================================================================

# REQUIRED — EMQX dashboard login
EMQX_DASHBOARD_USERNAME=admin
# REQUIRED — set a strong password (also set MQ_PASSWORD to match)
EMQX_DASHBOARD_PASSWORD=change-me

# REQUIRED — Erlang distribution cookie shared across all EMQX nodes in the cluster.
# Single-node: still required (Mria uses it internally).
# Multi-node: ALL nodes must have the same cookie or they will refuse to join.
EMQX_NODE_COOKIE=change-me-emqx-cookie

# Scaling to multiple EMQX nodes (optional — single node is fine to start):
# 1. Add more broker services in cloud.yml, each with a unique hostname.
# 2. Update EMQX_CLUSTER__STATIC__SEEDS in each service's environment block
#    to list all node names: "[edge-vpn-broker@node1, edge-vpn-broker@node2, ...]"
# 3. Use odd replica count (3 recommended) to avoid split-brain.
# 4. All other clustering env vars (DB_BACKEND, ROLE, AUTOHEAL, RPC) are
#    already set in cloud.yml and require no changes here.

# ==============================================================================
# EDGE AGENT (used in edge.yml)
# ==============================================================================

# Leave blank to use PUBLIC_ENROLLMENT_KEY_URLS instead
ENROLLMENT_KEY=

# REQUIRED — comma-separated list of admin URLs to fetch a public enrollment
# key from (tried in order). Any admin can mint a key (shared Postgres), so
# multiple URLs act as a pure availability fallback.
PUBLIC_ENROLLMENT_KEY_URLS=http://your-server-ip-or-domain.com:34000/api/v1/clusters/default/enrollment_keys/public

# Optional — friendly DNS names for this node (comma-separated). Conflicts silently ignored.
# Each alias becomes node-{alias}.cluster-{cluster}.{domain} in the VPN mesh.
# ALIASES=web-server

# Auto-update via Watchtower
SELF_UPDATE_ENABLED=true
WATCHTOWER_URL=http://localhost:58080
# REQUIRED — set a strong token
WATCHTOWER_HTTP_API_TOKEN=change-me
